# RunPod rollout env for MiniVLA hidden-state capture.
# Target: runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
# Compile with: uv pip compile requirements.in -o requirements.lock --generate-hashes

# --- Pin torch to RunPod's preinstalled version. Without this, uv resolves to whatever's newest on PyPI (currently torch 2.11+cu13), which has no prebuilt flash-attn wheel and breaks the whole setup.
torch==2.4.0
torchvision==0.19.0

# --- VLA / model-loading deps (versions match openvla-mini's tested set)
transformers==4.40.1
tokenizers==0.19.1
timm==0.9.10
huggingface_hub
accelerate>=0.25.0
sentencepiece==0.1.99
protobuf
draccus==0.8.0

# --- Used by flash-attn at runtime; pulled here so it lives in the lock
einops

# --- numpy 2.3.5+ for _blas_supports_fpe symbol; <2 breaks TF/JAX ABI
numpy>=2.3.5

# --- Pillow 12.0.0 has a broken _Ink import; 12.1.0 fixed it
Pillow>=12.1.0
